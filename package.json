  {
    "name": "@emulator-studio/source",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "description": "Open-source dashboards for local cloud emulators (GCP, AWS, Azure)",
    "scripts": {
      "prepare": "husky",
      "dev": "npx nx run-many --target=serve --projects=api,web --parallel=2 --output-style=stream",
      "dev:api": "npx nx serve api --output-style=stream",
      "dev:web": "npx nx serve web --output-style=stream",
      "build": "nx run-many --target=build --all",
      "test": "nx run-many --target=test --all",
      "lint": "nx run-many --target=lint --all",
      "format": "prettier --write .",
      "format:check": "prettier --check ."
    },
    "devDependencies": {
      "@commitlint/cli": "^20.1.0",
      "@commitlint/config-conventional": "^20.0.0",
      "@nx/esbuild": "^22.1.0",
      "@nx/eslint": "22.1.0",
      "@nx/eslint-plugin": "22.1.0",
      "@nx/js": "22.1.0",
      "@nx/node": "22.1.0",
      "@nx/react": "22.1.0",
      "@nx/vite": "22.1.0",
      "@nx/vitest": "22.1.0",
      "@nx/workspace": "22.1.0",
      "@swc-node/register": "~1.9.1",
      "@swc/core": "~1.5.7",
      "@swc/helpers": "~0.5.11",
      "@testing-library/react": "^16.0.0",
      "@types/cors": "^2.8.17",
      "@types/express": "^4.17.21",
      "@types/node": "^22.0.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@types/swagger-jsdoc": "^6.0.4",
      "@types/swagger-ui-express": "^4.1.6",
      "@vitejs/plugin-react": "^4.3.0",
      "@vitest/coverage-v8": "^4.0.0",
      "@vitest/ui": "^4.0.0",
      "autoprefixer": "^10.4.20",
      "eslint": "^9.8.0",
      "eslint-config-prettier": "^10.0.0",
      "eslint-plugin-import": "^2.31.0",
      "eslint-plugin-jsx-a11y": "^6.10.0",
      "eslint-plugin-react": "^7.37.0",
      "eslint-plugin-react-hooks": "^5.0.0",
      "husky": "^9.1.7",
      "jsdom": "^25.0.0",
      "nx": "22.1.0",
      "postcss": "^8.4.49",
      "prettier": "^3.4.0",
      "tailwindcss": "^3.4.17",
      "tsx": "^4.19.2",
      "typescript": "~5.9.2",
      "typescript-eslint": "^8.0.0",
      "vite": "^6.0.0",
      "vitest": "^4.0.0"
    },
    "workspaces": [
      "apps/*",
      "libs/*"
    ]
  }
