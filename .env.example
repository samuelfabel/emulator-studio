# Emulator
GOOGLE_CLOUD_PROJECT=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085
# Cloud Storage (fake-gcs-server)
#
# Local dev (npm run dev): set automatically when started from the Studio UI,
# or point at a container you start manually on the host.
STORAGE_EMULATOR_HOST=http://localhost:4443
#
# Docker Hub / compose: run fake-gcs as a separate service and use its network
# hostname — NOT localhost (localhost inside the Studio container is the Studio
# container itself). See README.md § "Running from Docker Hub".
# STORAGE_EMULATOR_HOST=http://fake-gcs:4443

# API (isolated backend)
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Web (React dashboard) — optional; dev uses Vite proxy when unset
# VITE_API_URL=http://localhost:3001
